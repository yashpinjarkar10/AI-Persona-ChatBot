# ── LLM & Embeddings ─────────────────────────────────────────────
GROQ_API_KEY=gsk_...
MistralAI=your-mistral-api-key

# ── Supabase ─────────────────────────────────────────────────────
# Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Admin Route Protection ───────────────────────────────────────
# Supabase Auth email authorized to call /admin/* endpoints via JWT
ADMIN_EMAIL=you@example.com

# Static API key fallback for /admin/* endpoints (Header: `X-Admin-Key`)
ADMIN_API_KEY=your-secret-admin-key

# ── Optional Overrides ───────────────────────────────────────────
# FACTS_FILE_PATH=./personal_facts.md
# CORS_ALLOW_ORIGINS=*
# PORT=8080

# ── LangSmith Tracing (Optional) ─────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT="SelfChatBot"
