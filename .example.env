# ── LLM & Embeddings ─────────────────────────────────────────────
GROQ_API_KEY=gsk_...
MistralAI=your-mistral-api-key

# ── LangSmith Tracing ────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT="SelfChatBot"

# ── Supabase ─────────────────────────────────────────────────────
# Get these from: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# The email you use to sign in to Supabase Auth — only this email
# can access /admin/* routes via JWT. (Obsolete under static API Key, but kept for legacy)
ADMIN_EMAIL=you@example.com

# A long-lived, secure static API key used to trigger /admin endpoints.
# Pass in request header: `X-Admin-Key: <your-key>`
ADMIN_API_KEY=your-secret-admin-key


# ── Optional overrides ───────────────────────────────────────────
# CHROMA_PERSIST_DIR=./app/db/chroma_db100
# KNOWLEDGE_DIR=./app/knowledge
# CORS_ALLOW_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# PORT=8080
