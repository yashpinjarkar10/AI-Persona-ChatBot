# ── LLM & Embeddings ─────────────────────────────────────────────
GROQ_API_KEY=gsk_...
MistralAI=your-mistral-api-key

# ── Supabase ─────────────────────────────────────────────────────
# Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Admin Route Protection ───────────────────────────────────────
# Static API key secret for /admin/* endpoints (Header: `X-Admin-Key` or `Authorization: Bearer <key>`)
ADMIN_API_KEY=your-secret-admin-key

# ── Allowed Frontend Domains (CORS) ──────────────────────────────
# Comma-separated list of allowed frontend URLs (no wildcard `*`)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-portfolio-domain.com

# ── Cloud Deployment Knowledge Ingestion ─────────────────────────
# PERSONAL_FACTS_BASE64=H4sIC...
# FACTS_FILE_PATH=/etc/secrets/personal_facts.md
# PORT=8080
